addMintGrant_removeMintGrant_roundTrip : Script ()
addMintGrant_removeMintGrant_roundTrip = do
  (issuer, _, _, minter) <- setupParties
  registries <- createRegistries issuer [] [minter] []

  grantedCid <- submit issuer do
    exerciseCmd registries.mintCid AddMintGrant with
      user = minter; proposalId = "admin-test-grant"; amount = 500
  amt <- submit issuer do exerciseCmd grantedCid GetMintAmount with user = minter
  amt === 500

  clearedCid <- submit issuer do
    exerciseCmd grantedCid RemoveMintGrant with user = minter
  amt2 <- submit issuer do exerciseCmd clearedCid GetMintAmount with user = minter
  amt2 === 0

