module Tests.AdminTests where

import DA.Assert
import Daml.Script
import Admin
import Tests.Common

-- ── AdminState: global pause ──────────────────────────────────────────

pauseAll_setsGlobalPaused : Script ()
pauseAll_setsGlobalPaused = do
  (issuer, _, _, _) <- setupParties
  registries <- createRegistries issuer [] [] []

  pausedCid <- submit issuer do exerciseCmd registries.complianceCid PauseAll
  Some paused <- queryContractId issuer pausedCid
  paused.globalPaused === True

pauseAll_rejectsDoublePause : Script ()
pauseAll_rejectsDoublePause = do
  (issuer, _, _, _) <- setupParties
  registries <- createRegistries issuer [] [] []

  pausedCid <- submit issuer do exerciseCmd registries.complianceCid PauseAll
  submitMustFail issuer do exerciseCmd pausedCid PauseAll

unpauseAll_clearsGlobalPaused : Script ()
unpauseAll_clearsGlobalPaused = do
  (issuer, _, _, _) <- setupParties
  registries <- createRegistries issuer [] [] []

  pausedCid <- submit issuer do exerciseCmd registries.complianceCid PauseAll
  unpausedCid <- submit issuer do exerciseCmd pausedCid UnpauseAll
  Some unpaused <- queryContractId issuer unpausedCid
  unpaused.globalPaused === False

unpauseAll_rejectsWhenNotPaused : Script ()
unpauseAll_rejectsWhenNotPaused = do
  (issuer, _, _, _) <- setupParties
  registries <- createRegistries issuer [] [] []

  submitMustFail issuer do exerciseCmd registries.complianceCid UnpauseAll

-- ── AdminState: blacklist ──────────────────────────────────────────────

addBlackList_removeBlackList_roundTrip : Script ()
addBlackList_removeBlackList_roundTrip = do
  (issuer, holder, _, _) <- setupParties
  registries <- createRegistries issuer [] [] []

  blacklistedCid <- submit issuer do
    exerciseCmd registries.complianceCid AddBlackList with user = holder
  Some blacklisted <- queryContractId issuer blacklistedCid
  (holder `elem` blacklisted.blackListed) === True

  cleanCid <- submit issuer do
    exerciseCmd blacklistedCid RemoveBlackList with user = holder
  Some clean <- queryContractId issuer cleanCid
  (holder `elem` clean.blackListed) === False

addBlackList_rejectsDuplicate : Script ()
addBlackList_rejectsDuplicate = do
  (issuer, holder, _, _) <- setupParties
  registries <- createRegistries issuer [holder] [] []

  submitMustFail issuer do
    exerciseCmd registries.complianceCid AddBlackList with user = holder

removeBlackList_rejectsWhenNotBlacklisted : Script ()
removeBlackList_rejectsWhenNotBlacklisted = do
  (issuer, holder, _, _) <- setupParties
  registries <- createRegistries issuer [] [] []

  submitMustFail issuer do
    exerciseCmd registries.complianceCid RemoveBlackList with user = holder

isBlackListedQuery_reflectsCurrentState : Script ()
isBlackListedQuery_reflectsCurrentState = do
  (issuer, holder, _, _) <- setupParties
  registries <- createRegistries issuer [holder] [] []

  result <- submit issuer do
    exerciseCmd registries.complianceCid IsBlackListed with user = holder
  result === True

-- ── MintRegistry: mint authorization ───────────────────────────────────

addCanMint_removeCanMint_roundTrip : Script ()
addCanMint_removeCanMint_roundTrip = do
  (issuer, _, _, minter) <- setupParties
  registries <- createRegistries issuer [] [] []

  authorizedCid <- submit issuer do
    exerciseCmd registries.mintCid AddCanMint with user = minter
  Some authorized <- queryContractId issuer authorizedCid
  (minter `elem` authorized.canMint) === True

  revokedCid <- submit issuer do
    exerciseCmd authorizedCid RemoveCanMint with user = minter
  Some revoked <- queryContractId issuer revokedCid
  (minter `elem` revoked.canMint) === False

