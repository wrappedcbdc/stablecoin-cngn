-- ── ForwarderRegistry: relayer allowlist ───────────────────────────────

addCanForward_removeCanForward_roundTrip : Script ()
addCanForward_removeCanForward_roundTrip = do
  (issuer, _, _, _) <- setupParties
  relayer <- allocateParty "AdminTestRelayer"
  registries <- createRegistries issuer [] [] []

  addedCid <- submit issuer do
    exerciseCmd registries.forwarderCid AddCanForward with user = relayer
  Some added <- queryContractId issuer addedCid
  (relayer `elem` added.canForward) === True

  removedCid <- submit issuer do
    exerciseCmd addedCid RemoveCanForward with user = relayer
  Some removed <- queryContractId issuer removedCid
  (relayer `elem` removed.canForward) === False

