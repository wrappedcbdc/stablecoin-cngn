-- ── TrustedContractRegistry ─────────────────────────────────────────────

addTrustedContract_removeTrustedContract_roundTrip : Script ()
addTrustedContract_removeTrustedContract_roundTrip = do
  (issuer, _, _, _) <- setupParties
  counterparty <- allocateParty "AdminTestCounterparty"
  registries <- createRegistries issuer [] [] []

  addedCid <- submit issuer do
    exerciseCmd registries.trustCid AddTrustedContract with contract = counterparty
  Some added <- queryContractId issuer addedCid
  (counterparty `elem` added.trustedContracts) === True

  removedCid <- submit issuer do
    exerciseCmd addedCid RemoveTrustedContract with contract = counterparty
  Some removed <- queryContractId issuer removedCid
  (counterparty `elem` removed.trustedContracts) === False

