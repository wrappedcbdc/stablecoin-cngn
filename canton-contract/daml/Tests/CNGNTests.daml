-- ── CNGNToken: Pause / UnPause / Merge / RejectToken ────────────────────

pause_unpause_roundTrip : Script ()
pause_unpause_roundTrip = do
  (issuer, holder, _, _) <- setupParties
  tokenCid <- submit issuer do
    createCmd CNGNToken with issuer; owner = holder; amount = 100; paused = False

  pausedCid <- submit issuer do exerciseCmd tokenCid Pause
  Some paused <- queryContractId issuer pausedCid
  paused.paused === True

  unpausedCid <- submit issuer do exerciseCmd pausedCid UnPause
  Some unpaused <- queryContractId issuer unpausedCid
  unpaused.paused === False

pause_rejectsDoublePause : Script ()
pause_rejectsDoublePause = do
  (issuer, holder, _, _) <- setupParties
  tokenCid <- submit issuer do
    createCmd CNGNToken with issuer; owner = holder; amount = 100; paused = False
  pausedCid <- submit issuer do exerciseCmd tokenCid Pause

  submitMustFail issuer do exerciseCmd pausedCid Pause

unPause_rejectsWhenNotPaused : Script ()
unPause_rejectsWhenNotPaused = do
  (issuer, holder, _, _) <- setupParties
  tokenCid <- submit issuer do
    createCmd CNGNToken with issuer; owner = holder; amount = 100; paused = False

  submitMustFail issuer do exerciseCmd tokenCid UnPause

merge_combinesAmounts : Script ()
merge_combinesAmounts = do
  (issuer, holder, _, _) <- setupParties
  _ <- createRegistries issuer [] [] []
  tokenCid1 <- submit issuer do
    createCmd CNGNToken with issuer; owner = holder; amount = 30; paused = False
  tokenCid2 <- submit issuer do
    createCmd CNGNToken with issuer; owner = holder; amount = 70; paused = False

  mergedCid <- submitMulti [holder, issuer] [] do exerciseCmd tokenCid1 Merge with otherCids = [tokenCid2]
  Some merged <- queryContractId holder mergedCid
  merged.amount === 100

-- Merge is gated the same way Transfer and BurnByUser are: a blacklisted
-- holder cannot even consolidate their own holdings.
merge_rejectsBlacklistedHolder : Script ()
merge_rejectsBlacklistedHolder = do
  (issuer, holder, _, _) <- setupParties
  _ <- createRegistries issuer [holder] [] []
  tokenCid1 <- submit issuer do
    createCmd CNGNToken with issuer; owner = holder; amount = 30; paused = False
  tokenCid2 <- submit issuer do
    createCmd CNGNToken with issuer; owner = holder; amount = 70; paused = False

  submitMultiMustFail [holder, issuer] [] do
    exerciseCmd tokenCid1 Merge with otherCids = [tokenCid2]

-- Merge is blocked during a global halt, just like Transfer and
-- BurnByUser — pause freezes disposition of a holding entirely, not
-- just its movement to another party.
merge_rejectsWhenGloballyPaused : Script ()
merge_rejectsWhenGloballyPaused = do
  (issuer, holder, _, _) <- setupParties
  registries <- createRegistries issuer [] [] []
  _ <- submit issuer do exerciseCmd registries.complianceCid PauseAll
  tokenCid1 <- submit issuer do
    createCmd CNGNToken with issuer; owner = holder; amount = 30; paused = False
  tokenCid2 <- submit issuer do
    createCmd CNGNToken with issuer; owner = holder; amount = 70; paused = False

  submitMultiMustFail [holder, issuer] [] do
    exerciseCmd tokenCid1 Merge with otherCids = [tokenCid2]

rejectToken_archivesHolding : Script ()
rejectToken_archivesHolding = do
  (issuer, holder, _, _) <- setupParties
  _ <- createRegistries issuer [] [] []
  tokenCid <- submit issuer do
    createCmd CNGNToken with issuer; owner = holder; amount = 1; paused = False

  submitMulti [holder, issuer] [] do exerciseCmd tokenCid RejectToken
  result <- queryContractId holder tokenCid
  result === (None : Optional CNGNToken)

-- RejectToken is gated the same way BurnByUser is: a blacklisted holder
-- cannot use it to dispose of an official holding outside compliance
-- control. This means RejectToken is no longer a route for a victim to
-- unilaterally clear a self-issued, non-cooperating party's unsolicited
-- token — see SECURITY.md.
rejectToken_rejectsBlacklistedHolder : Script ()
rejectToken_rejectsBlacklistedHolder = do
  (issuer, holder, _, _) <- setupParties
  _ <- createRegistries issuer [holder] [] []
  tokenCid <- submit issuer do
    createCmd CNGNToken with issuer; owner = holder; amount = 1; paused = False

  submitMultiMustFail [holder, issuer] [] do exerciseCmd tokenCid RejectToken

