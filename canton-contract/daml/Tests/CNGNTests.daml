    createCmd MintProposal with
      issuer; minter; mintTo = recipient; amount = 100; paused = False
      proposalId = "cngn-test-reject"

  submit minter do exerciseCmd proposalCid RejectMint

-- ── Allowance (approve / spend) ──────────────────────────────────────────

allowance_rejectsZeroAmount : Script ()
allowance_rejectsZeroAmount = do
  (issuer, holder, _, _) <- setupParties
  submitMustFail issuer do
    createCmd Allowance with tokenOwner = issuer; spender = holder; amount = 0

increaseAllowance_addsToBalance : Script ()
increaseAllowance_addsToBalance = do
  (issuer, holder, _, _) <- setupParties
  allowanceCid <- submit issuer do
    createCmd Allowance with tokenOwner = issuer; spender = holder; amount = 100

  increasedCid <- submit issuer do
    exerciseCmd allowanceCid IncreaseAllowance with addedValue = 50
  Some increased <- queryContractId issuer increasedCid
  increased.amount === 150

