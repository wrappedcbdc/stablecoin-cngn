module Tests.CNGNTests where

import DA.Assert
import Daml.Script
import Admin
import CNGN
import Tests.Common

-- ── CNGNToken: creation invariant ──────────────────────────────────────

cngnToken_rejectsZeroAmount : Script ()
cngnToken_rejectsZeroAmount = do
  (issuer, holder, _, _) <- setupParties
  submitMustFail issuer do
    createCmd CNGNToken with issuer; owner = holder; amount = 0; paused = False

cngnToken_rejectsNegativeAmount : Script ()
cngnToken_rejectsNegativeAmount = do
  (issuer, holder, _, _) <- setupParties
  submitMustFail issuer do
    createCmd CNGNToken with issuer; owner = holder; amount = -1; paused = False

-- ── CNGNToken: Transfer ─────────────────────────────────────────────────

transfer_movesFullBalance : Script ()
transfer_movesFullBalance = do
  (issuer, holder, recipient, _) <- setupParties
  _ <- createRegistries issuer [] [] []
  tokenCid <- submit issuer do
    createCmd CNGNToken with issuer; owner = holder; amount = 100; paused = False

  newCid <- submitMulti [holder, issuer] [] do
    exerciseCmd tokenCid Transfer with to = recipient; transferAmt = 100

  Some newToken <- queryContractId recipient newCid
  newToken.owner === recipient
  newToken.amount === 100

transfer_partialLeavesChangeWithSender : Script ()
transfer_partialLeavesChangeWithSender = do
  (issuer, holder, recipient, _) <- setupParties
  _ <- createRegistries issuer [] [] []
  tokenCid <- submit issuer do
    createCmd CNGNToken with issuer; owner = holder; amount = 100; paused = False

  _ <- submitMulti [holder, issuer] [] do
    exerciseCmd tokenCid Transfer with to = recipient; transferAmt = 40

  -- The original contract is archived; a fresh one for the unspent
  -- change (60) is created back to the holder.
  original <- queryContractId holder tokenCid
  original === (None : Optional CNGNToken)

  holderTokens <- query @CNGNToken holder
  let changeAmounts = map (\(_, tok) -> tok.amount) holderTokens
  changeAmounts === [60]

