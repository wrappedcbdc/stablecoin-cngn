  registries <- createRegistries issuer [] [] []
  _ <- submit issuer do exerciseCmd registries.complianceCid PauseAll
  tokenCid <- submit issuer do
    createCmd CNGNToken with issuer; owner = holder; amount = 1; paused = False

  submitMultiMustFail [holder, issuer] [] do exerciseCmd tokenCid RejectToken

-- ── MintProposal ─────────────────────────────────────────────────────────

mintProposal_rejectsZeroAmount : Script ()
mintProposal_rejectsZeroAmount = do
  (issuer, _, recipient, minter) <- setupParties
  submitMustFail issuer do
    createCmd MintProposal with
      issuer; minter; mintTo = recipient; amount = 0; paused = False
      proposalId = "cngn-test-zero"

executeMint_createsTokenAndConsumesGrant : Script ()
executeMint_createsTokenAndConsumesGrant = do
  (issuer, _, recipient, minter) <- setupParties
  _ <- createRegistries issuer [] [minter] [(minter, "cngn-test-mint", 100)]
  proposalCid <- submit issuer do
    createCmd MintProposal with
      issuer; minter; mintTo = recipient; amount = 100; paused = False
      proposalId = "cngn-test-mint"

  mintedCid <- submitMulti [minter, issuer] [] do exerciseCmd proposalCid ExecuteMint
  Some minted <- queryContractId recipient mintedCid
  minted.owner === recipient
  minted.amount === 100

executeMint_rejectsAmountMismatch : Script ()
executeMint_rejectsAmountMismatch = do
  (issuer, _, recipient, minter) <- setupParties
  _ <- createRegistries issuer [] [minter] [(minter, "cngn-test-mismatch", 100)]
  proposalCid <- submit issuer do
    createCmd MintProposal with
      issuer; minter; mintTo = recipient; amount = 999; paused = False
      proposalId = "cngn-test-mismatch"

  -- amount 999 has no matching grant recorded (grant is for 100), so a
  -- proposal minted at 999 will never find its own id/amount pairing
  submitMultiMustFail [minter, issuer] [] do exerciseCmd proposalCid ExecuteMint

executeMint_rejectsWrongProposalId : Script ()
executeMint_rejectsWrongProposalId = do
  (issuer, _, recipient, minter) <- setupParties
  _ <- createRegistries issuer [] [minter] [(minter, "expected-id", 100)]
  proposalCid <- submit issuer do
    createCmd MintProposal with
      issuer; minter; mintTo = recipient; amount = 100; paused = False
      proposalId = "different-id"

  submitMultiMustFail [minter, issuer] [] do exerciseCmd proposalCid ExecuteMint

