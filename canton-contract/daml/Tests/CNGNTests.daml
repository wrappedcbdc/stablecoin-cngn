cancelMint_archivesProposal : Script ()
cancelMint_archivesProposal = do
  (issuer, _, recipient, minter) <- setupParties
  proposalCid <- submit issuer do
    createCmd MintProposal with
      issuer; minter; mintTo = recipient; amount = 100; paused = False
      proposalId = "cngn-test-cancel"

  submit issuer do exerciseCmd proposalCid CancelMint
  result <- queryContractId issuer proposalCid
  result === (None : Optional MintProposal)

rejectMint_archivesProposal : Script ()
rejectMint_archivesProposal = do
