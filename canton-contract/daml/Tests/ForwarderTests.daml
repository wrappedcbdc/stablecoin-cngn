module Tests.ForwarderTests where

import DA.Assert
import Daml.Script
import Admin
import CNGN
import Forwarder
import Tests.Common

-- Standard fixture: an issuer with a minter authorized to mint and
-- forward, a relayer authorized to forward, and the minter's nonce
-- tracker at 0. Returns the pieces each test needs to build its own
-- ForwardRequest.
setupForwarderFixture : Text -> Script (Party, Party, Party, Party, ContractId MintProposal)
setupForwarderFixture proposalId = do
  (issuer, _, recipient, minter) <- setupParties
  relayer <- allocateParty ("Relayer-" <> proposalId)
  registries <- createRegistries issuer [] [minter] [(minter, proposalId, 100)]
  _ <- submit issuer do exerciseCmd registries.forwarderCid AddCanForward with user = relayer
  _ <- submit minter do createCmd NonceTracker with owner = minter; nonce = 0

  proposalCid <- submit issuer do
    createCmd MintProposal with
      issuer; minter; mintTo = recipient; amount = 100; paused = False; proposalId

  return (issuer, minter, relayer, recipient, proposalCid)

execute_mintsToRecipient : Script ()
execute_mintsToRecipient = do
  (issuer, minter, relayer, recipient, proposalCid) <- setupForwarderFixture "fwd-test-success"

  requestCid <- submitMulti [minter, issuer] [] do
    createCmd ForwardRequest with
      from = minter; relayer; to = issuer; nonce = 0
      payload = ForwardPayload with mintProposalCid = proposalCid

  mintedCid <- submitMulti [relayer] [issuer, minter] do exerciseCmd requestCid Execute
  Some minted <- queryContractId recipient mintedCid
  minted.owner === recipient
  minted.amount === 100

execute_rejectsUnauthorizedRelayer : Script ()
execute_rejectsUnauthorizedRelayer = do
  (issuer, minter, _, recipient, proposalCid) <- setupForwarderFixture "fwd-test-bad-relayer"
  outsiderRelayer <- allocateParty "OutsiderRelayer"

  requestCid <- submitMulti [minter, issuer] [] do
    createCmd ForwardRequest with
      from = minter; relayer = outsiderRelayer; to = issuer; nonce = 0
      payload = ForwardPayload with mintProposalCid = proposalCid

  submitMultiMustFail [outsiderRelayer] [issuer, minter] do exerciseCmd requestCid Execute

execute_rejectsBlacklistedRelayer : Script ()
execute_rejectsBlacklistedRelayer = do
  (issuer, minter, relayer, recipient, proposalCid) <- setupForwarderFixture "fwd-test-blacklisted-relayer"
  Some (complianceCid, _) <- queryContractKey @AdminState issuer issuer
  _ <- submit issuer do exerciseCmd complianceCid AddBlackList with user = relayer

  requestCid <- submitMulti [minter, issuer] [] do
    createCmd ForwardRequest with
      from = minter; relayer; to = issuer; nonce = 0
      payload = ForwardPayload with mintProposalCid = proposalCid

  submitMultiMustFail [relayer] [issuer, minter] do exerciseCmd requestCid Execute

