execute_rejectsMinterNotAuthorizedToMint : Script ()
execute_rejectsMinterNotAuthorizedToMint = do
  (issuer, _, recipient, minter) <- setupParties
  relayer <- allocateParty "Relayer-fwd-test-no-canmint"
  registries <- createRegistries issuer [] [] []   -- minter never authorized to mint
  _ <- submit issuer do exerciseCmd registries.forwarderCid AddCanForward with user = relayer
  _ <- submit minter do createCmd NonceTracker with owner = minter; nonce = 0

  proposalCid <- submit issuer do
    createCmd MintProposal with
      issuer; minter; mintTo = recipient; amount = 100; paused = False
      proposalId = "fwd-test-no-canmint"

  requestCid <- submitMulti [minter, issuer] [] do
    createCmd ForwardRequest with
      from = minter; relayer; to = issuer; nonce = 0
      payload = ForwardPayload with mintProposalCid = proposalCid

  submitMultiMustFail [relayer] [issuer, minter] do exerciseCmd requestCid Execute

execute_rejectsNonceMismatch : Script ()
execute_rejectsNonceMismatch = do
  (issuer, minter, relayer, recipient, proposalCid) <- setupForwarderFixture "fwd-test-nonce-mismatch"

  requestCid <- submitMulti [minter, issuer] [] do
    createCmd ForwardRequest with
      from = minter; relayer; to = issuer; nonce = 7
      payload = ForwardPayload with mintProposalCid = proposalCid

  submitMultiMustFail [relayer] [issuer, minter] do exerciseCmd requestCid Execute

execute_cannotReuseAConsumedNonce : Script ()
execute_cannotReuseAConsumedNonce = do
  (issuer, minter, relayer, recipient, proposal1) <- setupForwarderFixture "fwd-test-replay-1"

  request1 <- submitMulti [minter, issuer] [] do
    createCmd ForwardRequest with
      from = minter; relayer; to = issuer; nonce = 0
      payload = ForwardPayload with mintProposalCid = proposal1

  _ <- submitMulti [relayer] [issuer, minter] do exerciseCmd request1 Execute

  Some (freshMintCid, _) <- queryContractKey @MintRegistry issuer issuer
  mintCid2 <- submit issuer do exerciseCmd freshMintCid AddCanMint with user = minter
  _ <- submit issuer do
    exerciseCmd mintCid2 AddMintGrant with user = minter; proposalId = "fwd-test-replay-2"; amount = 100

  proposal2 <- submit issuer do
    createCmd MintProposal with
      issuer; minter; mintTo = recipient; amount = 100; paused = False
      proposalId = "fwd-test-replay-2"

  request2 <- submitMulti [minter, issuer] [] do
    createCmd ForwardRequest with
      from = minter; relayer; to = issuer; nonce = 0   -- already consumed
      payload = ForwardPayload with mintProposalCid = proposal2

  submitMultiMustFail [relayer] [issuer, minter] do exerciseCmd request2 Execute

execute_secondRequestSucceedsWithIncrementedNonce : Script ()
execute_secondRequestSucceedsWithIncrementedNonce = do
  (issuer, minter, relayer, recipient, proposal1) <- setupForwarderFixture "fwd-test-sequence-1"

  request1 <- submitMulti [minter, issuer] [] do
    createCmd ForwardRequest with
      from = minter; relayer; to = issuer; nonce = 0
      payload = ForwardPayload with mintProposalCid = proposal1

  _ <- submitMulti [relayer] [issuer, minter] do exerciseCmd request1 Execute

  Some (freshMintCid, _) <- queryContractKey @MintRegistry issuer issuer
  mintCid2 <- submit issuer do exerciseCmd freshMintCid AddCanMint with user = minter
  _ <- submit issuer do
    exerciseCmd mintCid2 AddMintGrant with user = minter; proposalId = "fwd-test-sequence-2"; amount = 100

  proposal2 <- submit issuer do
    createCmd MintProposal with
      issuer; minter; mintTo = recipient; amount = 100; paused = False
      proposalId = "fwd-test-sequence-2"

  request2 <- submitMulti [minter, issuer] [] do
    createCmd ForwardRequest with
      from = minter; relayer; to = issuer; nonce = 1   -- correctly incremented
      payload = ForwardPayload with mintProposalCid = proposal2

  mintedCid <- submitMulti [relayer] [issuer, minter] do exerciseCmd request2 Execute
  Some minted <- queryContractId recipient mintedCid
  minted.amount === 100

rejectForward_archivesRequest : Script ()
rejectForward_archivesRequest = do
  (issuer, minter, relayer, _, proposalCid) <- setupForwarderFixture "fwd-test-reject"

  requestCid <- submitMulti [minter, issuer] [] do
    createCmd ForwardRequest with
      from = minter; relayer; to = issuer; nonce = 0
      payload = ForwardPayload with mintProposalCid = proposalCid

  submit relayer do exerciseCmd requestCid RejectForward
  result <- queryContractId relayer requestCid
  result === (None : Optional ForwardRequest)

-- ── NonceTracker ─────────────────────────────────────────────────────────

nonceTracker_incrementNonce_advancesByOne : Script ()
nonceTracker_incrementNonce_advancesByOne = do
  minter <- allocateParty "NonceTestMinter"
  trackerCid <- submit minter do createCmd NonceTracker with owner = minter; nonce = 0

  advancedCid <- submit minter do exerciseCmd trackerCid IncrementNonce
  current <- submit minter do exerciseCmd advancedCid GetNonce
  current === 1

nonceTracker_getNonce_reflectsCurrentValue : Script ()
nonceTracker_getNonce_reflectsCurrentValue = do
  minter <- allocateParty "NonceTestMinter2"
  trackerCid <- submit minter do createCmd NonceTracker with owner = minter; nonce = 5

  current <- submit minter do exerciseCmd trackerCid GetNonce
  current === 5
