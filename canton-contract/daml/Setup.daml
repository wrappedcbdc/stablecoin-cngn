module Setup where

import Admin
import CNGN ()
import Forwarder
import Daml.Script

data Parties = Parties
  with
    owner   : Party
    minter  : Party
    relayer : Party

initialize : Script ()
initialize = do
  owner   <- allocatePartyWithHint "Owner"   (PartyIdHint "Owner")
  minter  <- allocatePartyWithHint "Minter"  (PartyIdHint "Minter")
  relayer <- allocatePartyWithHint "Relayer" (PartyIdHint "Relayer")

  -- Compliance registry: blacklist and global pause, owned by the issuer.
  _ <- submit owner do
    createCmd AdminState with
      owner        = owner
      blackListed  = []
      globalPaused = False

  -- Mint registry: who may mint, and their outstanding grants.
  mintCid <- submit owner do
    createCmd MintRegistry with
      owner      = owner
      canMint    = [owner]   -- owner can mint initially
      mintGrants = []

  mintCid <- submit owner do
    exerciseCmd mintCid AddCanMint with user = minter

  _ <- submit owner do
    exerciseCmd mintCid AddMintGrant with
      user = minter; proposalId = "setup-demo-proposal"; amount = 1_000_000

  -- Forwarder registry: relayer allowlist.
  _ <- submit owner do
    createCmd ForwarderRegistry with
      owner      = owner
      canForward = [relayer]

  -- Trusted contract registry.
  _ <- submit owner do
    createCmd TrustedContractRegistry with
      owner            = owner
      trustedContracts = []

  -- Nonce tracker for the minter's forward requests (replay protection).
  submit minter do
    createCmd NonceTracker with
      owner = minter
      nonce = 0

  return ()
